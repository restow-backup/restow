#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Nothing of a connected disk becomes active by itself, SSH stays off until the
# operator switches remote access on, and the recovery program owns the first
# console (README.md, "No auto-activation").
set -eu

# GPT partitions of other disks are never mounted by the generator. The folder for
# local generator overrides does not exist in a fresh image.
mkdir -p /etc/systemd/system-generators
ln -sf /dev/null /etc/systemd/system-generators/systemd-gpt-auto-generator
# No RAID array assembles by itself (AUTO -all). live-build's own hook
# 8040-remove-mdadm-configuration deletes /etc/mdadm/mdadm.conf after the includes are
# copied (it would hold the arrays of the build host); the live hooks run after it.
install -D -m 0644 /usr/lib/restow-recovery/mdadm.conf /etc/mdadm/mdadm.conf
# No swap of a connected disk, no LVM or RAID activation by event.
for unit in lvm2-monitor.service lvm2-lvmpolld.socket mdmonitor.service mdcheck_start.timer \
  mdcheck_continue.timer mdmonitor-oneshot.timer swap.target; do
  systemctl mask "$unit" >/dev/null 2>&1 || true
done
# Remote access is switched on by the recovery program only.
systemctl disable ssh.service ssh.socket >/dev/null 2>&1 || true
systemctl mask ssh.socket >/dev/null 2>&1 || true
# The address comes from systemd-networkd; the recovery program starts on tty1.
systemctl enable systemd-networkd.service systemd-resolved.service systemd-timesyncd.service
systemctl enable restow-recover.service
ln -sf /usr/lib/restow-recovery/restow-agent /usr/local/sbin/restow-agent
