# SPDX-License-Identifier: GPL-3.0-or-later
#
# The BIOS boot menu of the recovery ISO (syslinux), the same entries as the GRUB menu
# (grub-pc/grub.cfg). live-build fills in @LINUX@, @INITRD@ and @APPEND_LIVE@. Serial
# console, default and time limit are in isolinux.cfg.
label restow
	menu label Restow Recovery
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ noswap nopersistence live-media-timeout=30 modprobe.blacklist=amdgpu,radeon,nouveau,xe restow.keymap=us
label restow-ttys0
	menu label Restow Recovery (serial console ttyS0, 115200)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ noswap nopersistence live-media-timeout=30 modprobe.blacklist=amdgpu,radeon,nouveau,xe console=tty0 console=ttyS0,115200n8 restow.console=ttyS0 restow.keymap=us
label restow-ttys1
	menu label Restow Recovery (serial console ttyS1, 115200)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ noswap nopersistence live-media-timeout=30 modprobe.blacklist=amdgpu,radeon,nouveau,xe console=tty0 console=ttyS1,115200n8 restow.console=ttyS1 restow.keymap=us
label restow-nomodeset
	menu label Restow Recovery (basic graphics, nomodeset)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ noswap nopersistence live-media-timeout=30 modprobe.blacklist=amdgpu,radeon,nouveau,xe nomodeset restow.keymap=us
label restow-graphics
	menu label Restow Recovery (with graphics drivers)
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ noswap nopersistence live-media-timeout=30 restow.keymap=us

