{
  "name": "@restow/core",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Restow open storage format: content-defined chunking, per-tenant crypto and the encrypted pack store.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./html-text": {
      "types": "./src/mailfiles/html-text.ts",
      "default": "./dist/mailfiles/html-text.js"
    }
  },
  "files": [
    "dist",
    "!**/*.test.*",
    "!**/testdata",
    "!**/testing",
    "!**/fixtures",
    "!src/mailfiles/dev"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@kenjiuno/msgreader": "^1.28.0",
    "archiver": "^7.0.1",
    "imapflow": "^1.0.171",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.14",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@microsoft/microsoft-graph-types": "^2.40.0",
    "@tutao/oxmsg": "^0.2.3",
    "@types/archiver": "^6.0.3",
    "@types/mailparser": "^3.9.0",
    "@types/yauzl": "^3.4.0"
  }
}
