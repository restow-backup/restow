{
  "name": "@restow/i18n",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Restow translations (de, en) and the shared i18next setup with ICU message formatting.",
  "license": "Apache-2.0",
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/src/index.js"
    },
    "./resources/*": "./resources/*"
  },
  "files": ["dist", "resources", "!**/*.test.*"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^24.2.0",
    "i18next-icu": "^2.3.0",
    "intl-messageformat": "^10.7.0"
  }
}
