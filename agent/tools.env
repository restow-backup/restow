# shellcheck shell=sh
# Pinned versions and checksums of everything the agent build and its tests
# download. This is the ONE place to change them; build.sh, scripts/ and CI read
# it. The checksums are compared with the downloaded file before anything is
# unpacked (they are not fetched from the same place as the file). To update,
# run scripts/pin-tools.sh and review the diff.
#
# Format: KEY=value, sourced by POSIX sh. No secrets belong here.

# Go image used to build (any 1.26+ toolchain works; go.mod says go 1.26).
GO_IMAGE=golang:1.27

# restic (BSD-2-Clause). Checksums taken from the official release
# https://github.com/restic/restic/releases/tag/v0.19.1 after verifying the GPG
# signature of its SHA256SUMS with scripts/pin-tools.sh (2026-09-30).
RESTIC_VERSION=0.19.1
RESTIC_SHA256_linux_amd64=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
RESTIC_SHA256_linux_arm64=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465
RESTIC_SHA256_darwin_amd64=c38d579622cf602f665234c5a8c315030b6cf70656028fe6dc29a786b60e5f35
RESTIC_SHA256_darwin_arm64=7be0a144ccc377880f294204aa271d76e4b79554b42a751151d425ce6ebac143

# rest-server (BSD-2-Clause): only used by the integration tests as a stand-in
# for the Restow restic endpoint. It is not shipped. Pinned the same way.
REST_SERVER_VERSION=0.14.0
REST_SERVER_SHA256_linux_amd64=4c9c95bc079a0334e81fad379b19dc5c3353c71c2c88d652cafce2081c2b1c66
REST_SERVER_SHA256_linux_arm64=cef139cbe8b27b16bda731d17f093b0aa466b8c60b136c12d78b6f2bff3daf22
REST_SERVER_SHA256_darwin_amd64=ced47a785aec6a9fa3041cfa799dcc6c55527a12944d7a8147fc1595b5b0e945
REST_SERVER_SHA256_darwin_arm64=057004ce24ca9edfbe0e391eae87981ab03f2abb6b65cf8fdfcddf847ded8656
