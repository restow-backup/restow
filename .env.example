# Restow environment. Copy to .env and fill in. NEVER commit .env or real values.
# Empty values fall back to the default named in the comment above them.

# --- Core ---
# NODE_ENV is deliberately absent: the image runs with NODE_ENV=production, and any
# entry here, even an empty one, would override it. Production mode refuses the
# public default auth secret and localhost passkey origins.
# HTTP port of the API process (default 3000)
PORT=
# Host port on which docker-compose.yml publishes the api on 127.0.0.1 (default 3000). Caddy
# reaches the api over the compose network and does not need it.
RESTOW_API_PORT=
# Public origin the browser uses (origin only), e.g. https://app.example.com or http://localhost:5173
RESTOW_PUBLIC_URL=
# Public app domain for the Caddy edge (automatic Let's Encrypt TLS), e.g. app.example.com
RESTOW_APP_DOMAIN=
# Base URL of the api, read by the demo seed only (deploy/demo); the api, worker and scheduler
# do not use it. Leave empty.
RESTOW_API_URL=
# Operating mode: local | public  (set by the setup wizard; may be pinned here)
RESTOW_MODE=
# Public demo only (deploy/demo/README.md): the edition the demo shows without a license key,
# community | business | service_provider. Honoured by the ee/ modules only together with
# RESTOW_DEMO=true; anywhere else it has no effect. Leave empty.
RESTOW_EDITION=
# Optional override of the Ed25519 license key verification key (raw, base64url), for
# development and tests of the full build. Release images carry the vendor's key.
RESTOW_LICENSE_PUBLIC_KEY=
# RESTOW_VERSION (the running release) is written into the image at build time; do not set it
# here, an empty value would hide it.
# Update check. Off until an administrator turns it on under Settings, Updates (source, channel
# and an optional access token are set there). This variable is an environment override: a
# releases endpoint over https (e.g. https://api.github.com/repos/<owner>/<repo>/releases or
# .../releases/latest). When set it wins over the tab (the check is on, the source is this URL
# and read-only there, no stored token is sent to it). Empty = the tab decides. Either way only
# the release list is read; no installation data is ever sent.
RESTOW_UPDATE_CHECK_URL=
# Log level of the worker: debug | info | warn | error (default info)
LOG_LEVEL=
# Page that failure explanations in the UI point to for more help (default: the public
# troubleshooting page of the documentation). Point it at your own runbook if you keep one.
RESTOW_DOCS_TROUBLESHOOTING_URL=
# The product name the web app, mails, reports and the API documentation show (default
# "Restow"). It is a display name only: the RESTOW_* variables, the restow-agent and
# restow-restore programs, the X-Restow-* headers and the image names keep their names. The
# static maintenance page is written when the web image is built and carries the name the
# build was given (RESTOW_PRODUCT_NAME at build time), not this runtime value.
RESTOW_PRODUCT_NAME=

# --- Opt-in updater (docker compose --profile updater, docs/UPDATING.md) ---
# The updater mounts the Docker socket, which is root on this host: read the security note in
# docs/UPDATING.md before enabling it.
# Absolute path of the directory holding docker-compose.yml and .env on the host (mounted at the
# same path into the updater), e.g. /opt/restow. Default /srv/restow.
RESTOW_PROJECT_DIR=
# Image references the compose services run. Written here by the updater; leave empty to run
# what `docker compose build` produces (restow:local, restow-web:local).
RESTOW_IMAGE=
RESTOW_WEB_IMAGE=
# The updater's own image. Never written by the updater (it holds the Docker socket, so it must
# not run what it installed); empty = restow:local, the image `docker compose build` produces.
# To move the updater to a new release, set the release image here (for example
# ghcr.io/restow-backup/restow:0.1.0), check its signature (docs/UPDATING.md) and recreate it:
# docker compose --profile updater up -d updater
RESTOW_UPDATER_IMAGE=
# Repositories the updater may build an update from ("source" mode, a custom update source
# under Settings, Updates). Empty = none: source mode is off and only the signed release
# images of the default source can be installed from the web interface. Comma-separated, each
# a repository (git.example.com/acme/restow, github.com/acme/restow) or a whole host
# (git.example.com). Whatever is built from these repositories runs with access to all data
# and keys: list only repositories you trust as much as the release itself. Recreate the
# updater after a change (docker compose --profile updater up -d updater).
RESTOW_UPDATER_SOURCE_HOSTS=
# Where the api looks for the updater (default http://updater:8090, the updater service of the
# compose profile). Change it only for an updater that runs elsewhere.
RESTOW_UPDATER_URL=

# --- Edge (Caddyfile) ---
# Peers whose X-Forwarded-For the edge keeps (and appends to) instead of replacing with
# the peer's own address: space-separated CIDR ranges, or `private_ranges`. Needed only
# when another reverse proxy sits in front of this one (default: loopback only, which no
# real client connects from, so nothing changes for a normal installation). The api reads
# the same value: it records the right-most X-Forwarded-For hop that is not one of these
# proxies as the client address (audit log, sign-in limits), never the left-most one,
# which the client itself can write. Use a space-separated list here (the edge reads it).
RESTOW_EDGE_TRUSTED_PROXIES=
# Send Strict-Transport-Security once RESTOW_APP_DOMAIN is a real, publicly resolvable
# domain with this edge terminating its own valid TLS certificate (RESTOW_MODE=public,
# "Public mode" in the setup wizard): true | false (default false). The Caddyfile
# compares this value literally, so it must be exactly lowercase "true" — anything
# else, including "True" or "1", is treated as unset and leaves HSTS off. Never set
# this for a local/IP installation or a bare HTTP domain — HSTS then locks browsers
# into HTTPS for a host that may never serve it, with no way back short of the
# max-age expiring. Sent with includeSubDomains, so it applies to every subdomain of
# RESTOW_APP_DOMAIN too, not only that exact host.
RESTOW_EDGE_HSTS=

# --- Database ---
# docker compose: the postgres service requires POSTGRES_PASSWORD (POSTGRES_USER and
# POSTGRES_DB default to "restow"); in compose the DB host is the service name.
# Three roles, three connection strings, three different passwords:
#   DATABASE_MIGRATION_URL  the database owner (POSTGRES_USER); runs the migrations only,
#                           e.g. postgres://restow:<POSTGRES_PASSWORD>@postgres:5432/restow
#   DATABASE_URL            the application role, subject to Row Level Security. The
#                           migration step creates it with the name and password given here,
#                           e.g. postgres://restow_app:<password>@postgres:5432/restow
#   DATABASE_PROVIDER_URL   the installation role (BYPASSRLS), created the same way,
#                           e.g. postgres://restow_provider:<password>@postgres:5432/restow
# The processes refuse to start when DATABASE_URL is a superuser or can bypass RLS.
POSTGRES_PASSWORD=
# Owner role and database name of the postgres service (default restow for both). Change them
# only before the first start, and use the same names in DATABASE_MIGRATION_URL.
POSTGRES_USER=
POSTGRES_DB=
# Port on which docker-compose.yml publishes the postgres service on 127.0.0.1 (default 5432).
# Set another one when this host already runs a PostgreSQL on 5432.
POSTGRES_PORT=
DATABASE_MIGRATION_URL=
DATABASE_URL=
DATABASE_PROVIDER_URL=

# --- Secrets / crypto (generate with: openssl rand -base64 32) ---
# Required: 32-byte key encryption key (KEK), base64. Wraps every tenant key; keep a copy offline.
RESTOW_MASTER_KEY=
# Required: better-auth secret
BETTER_AUTH_SECRET=
# Optional: the one-time setup token the setup wizard asks for in its first step. Leave it
# empty and the api prints a fresh token to its log at every start until the setup is
# complete (docker compose logs api | grep 'SETUP TOKEN'). Set it (at least 16 characters,
# e.g. openssl rand -hex 16) for an unattended installation; it is then never logged.
# Has no effect once the setup is complete.
RESTOW_SETUP_TOKEN=

# --- Microsoft Entra (multi-tenant app for backup, client credentials) ---
# Optional: the app registration can instead be entered in the web UI under
# Settings -> Microsoft 365 (stored encrypted, effective without a restart). When
# ENTRA_CLIENT_ID plus ENTRA_CLIENT_SECRET or ENTRA_CLIENT_CERT_PATH are set here,
# they take precedence and the web UI shows them read-only.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Optional: certificate path (PEM with private key and certificate) instead of a secret
ENTRA_CLIENT_CERT_PATH=
# Optional: authority host for sovereign clouds (default https://login.microsoftonline.com)
ENTRA_AUTHORITY_HOST=
# Hours between full directory enumerations; incremental runs happen in between (default 24)
DIRECTORY_FULL_SYNC_HOURS=

# --- End-user SSO (delegated OIDC via Entra 'common') ---
# Not usable in 0.1.0: linking a Restow account to a Microsoft identity is
# planned, and the login page does not offer the button yet. Leave all three empty.
# While the switch is empty the sign-in endpoints answer 404. Developers can switch it on
# with RESTOW_EXPERIMENTAL_MICROSOFT_SIGN_IN=true (together with the two SSO app values,
# public mode and an edition that includes it); it is not supported and
# nobody could sign in with it, because no account is linked to a Microsoft identity.
ENTRA_SSO_CLIENT_ID=
ENTRA_SSO_CLIENT_SECRET=
RESTOW_EXPERIMENTAL_MICROSOFT_SIGN_IN=

# --- Notifications: mail transport = smtp | graph ---
MAIL_TRANSPORT=
# SMTP transport
SMTP_HOST=
SMTP_PORT=
# true: implicit TLS (also assumed for port 465); otherwise STARTTLS
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Microsoft Graph sendMail transport
GRAPH_MAIL_SENDER=
# Entra tenant of the sender mailbox, when the setup wizard names none
GRAPH_MAIL_TENANT_ID=

# --- IMAP sources ---
# true permits IMAP sources without TLS. Development only; never in production.
IMAP_ALLOW_INSECURE=
# true lets every IMAP source reach loopback and private networks (default: only servers a
# provider admin saved; tenant admins are limited to public servers)
IMAP_ALLOW_PRIVATE_NETWORKS=

# --- Storage (default target: local path inside the container) ---
# Target type: local | s3
STORAGE_TARGET=local
STORAGE_LOCAL_PATH=/data/chunks
# Optional second target every default write is copied to (a mounted NFS/SMB share)
STORAGE_COPY_LOCAL_PATH=
# S3-compatible target (optional): e.g. Hetzner Object Storage, Garage, Wasabi, B2, AWS
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_PREFIX=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# false for virtual-hosted bucket addressing (default true: path style)
S3_FORCE_PATH_STYLE=

# --- Worker ---
# Parallel jobs per queue in one worker process (default 2)
WORKER_CONCURRENCY=
# Parallel jobs per tenant in one worker process (default 2)
WORKER_TENANT_CONCURRENCY=
# pg-boss polling interval in seconds (default 2)
WORKER_POLL_SECONDS=
# How long shutdown waits for running jobs to checkpoint (default 30000)
WORKER_SHUTDOWN_TIMEOUT_MS=
# How often a running job checks whether it was cancelled (default 15000)
WORKER_CANCEL_POLL_MS=
# Progress is written every N items (default 50) or at least every M milliseconds (default 2000)
WORKER_PROGRESS_FLUSH_ITEMS=
WORKER_PROGRESS_FLUSH_MS=

# --- Mail file import and export (https://docs.restowbackup.com/administrators/mail-import-export/) ---
# Host directory that is mounted read-only at /var/lib/restow/import in the api and the worker.
# Each tenant uses its own subfolder <directory>/<tenant slug>/ (create it yourself): drop EML,
# MSG, MBOX or ZIP files (or a MailStore export folder) there and pick them in Sources > Add
# source > Import mail files. Default: ./import next to docker-compose.yml.
RESTOW_IMPORT_DIR=
# Path inside the containers (default /var/lib/restow/import); change only with the mount above
IMPORT_DIR=
# Largest file accepted by the upload in bytes (default 10 GiB)
IMPORT_MAX_FILE_BYTES=
# Hours an unfinished or unused upload is kept before it is deleted (default 48)
IMPORT_UPLOAD_TTL_HOURS=
# Size of one upload chunk in bytes (default 8 MiB, allowed 64 KiB to 32 MiB)
IMPORT_SEGMENT_BYTES=
# Largest single message that is read into memory (default 256 MiB)
IMPORT_MAX_MESSAGE_BYTES=
# Bytes the uploads of one tenant may hold in staging together, counted by declared file size
# until their import has ended (default 100 GiB). A new upload that does not fit is refused.
IMPORT_MAX_STAGING_BYTES=
# Parser processes the worker runs at the same time for MSG files and message metadata, 1 to 8
# (default 2). Each one may use up to 512 MB (files above 8 MiB get a process of their own,
# up to 3 GB): lower it on a small host.
IMPORT_PARSE_WORKERS=
# Hours a finished export can be downloaded before its file is deleted (default 24)
EXPORT_TTL_HOURS=
# Bytes all unexpired export files of one tenant may take together (default 50 GiB). A new
# export request is refused, and one that no longer fits fails with a message, until older
# exports have expired.
EXPORT_MAX_TENANT_BYTES=
# Parser processes the API runs at the same time for the mail preview and attachment downloads,
# 1 to 8 (default 2), and the time one message may take for its formatted preview in
# milliseconds (default 10000); a message that needs more is shown as text or as unreadable
PREVIEW_PARSE_WORKERS=
PREVIEW_TIMEOUT_MS=

# --- Webhooks (delivered by the worker) ---
# Poll interval for due deliveries (default 5000), parallel deliveries (default 4),
# per-attempt timeout (default 10000)
WEBHOOK_POLL_MS=
WEBHOOK_CONCURRENCY=
WEBHOOK_TIMEOUT_MS=
# true permits webhook targets in loopback and private networks (default: refused)
RESTOW_WEBHOOK_ALLOW_PRIVATE=

# --- Scheduler ---
# Tick interval (default 30000), leader retry (default 15000), due schedules per tick (default 200),
# delay before a schedule that cannot be planned (invalid cron) is looked at again (default 3600000)
SCHEDULER_TICK_MS=
SCHEDULER_LEADER_RETRY_MS=
SCHEDULER_BATCH_SIZE=
SCHEDULER_DEFER_MS=
# Postgres advisory lock key for leader election; change only when two installations share a database
SCHEDULER_LOCK_KEY=
# IANA time zone of the recommended schedules, e.g. Europe/Vienna (default Europe/Berlin);
# an unknown zone stops the scheduler. apps/scheduler/README.md has the full picture.
SCHEDULER_DEFAULT_TIMEZONE=

# --- Endpoint backup (servers and clients, https://docs.restowbackup.com/administrators/endpoint-backup/overview/) ---
# The restic binary the api and the worker run for retention, checks, restore tests, browsing and
# downloads (default: `restic` from the PATH; the image ships it in /usr/local/bin).
RESTIC_BINARY=
# Where restic keeps its per-endpoint caches (default: the temp folder). A folder on a volume
# (e.g. /data/restic-cache) keeps them across restarts and makes browsing faster.
RESTOW_RESTIC_CACHE_DIR=
# Where the image keeps the agent binaries and install scripts (default /srv/agent, with the
# scripts in /srv/agent/install); a development checkout reads agent/install from the repository.
RESTOW_AGENT_DIR=
RESTOW_AGENT_INSTALL_DIR=
# Storage budget of endpoint repositories in GiB (whole or decimal numbers; 0 = no budget).
# Per endpoint (default 2048 = 2 TiB; an admin can set another value per machine) and for all
# endpoints of one tenant together (default 20480 = 20 TiB). An upload beyond a budget is
# refused, restores keep working, and the alerts warn from 90 percent. Read by api and worker.
RESTOW_ENDPOINT_QUOTA_GIB=
RESTOW_ENDPOINT_TENANT_QUOTA_GIB=

# --- Journal SMTP receiver (archive; Business and Service Provider) ---
# Port the receiver listens on. Empty keeps it off: nothing listens, and docker-compose.yml maps
# a closed port (2525) on the loopback interface only, so a default installation opens no mail
# port to the network. To receive Exchange Online journal reports set it to 25 (Exchange Online
# always delivers to port 25) and JOURNAL_SMTP_BIND to 0.0.0.0, because the receiver has to be
# reachable from the internet. It needs JOURNAL_HOSTNAME and a TLS certificate (below).
JOURNAL_SMTP_PORT=
# Host interface docker-compose.yml publishes the receiver's port on (default 127.0.0.1). Set
# 0.0.0.0 together with JOURNAL_SMTP_PORT to make it reachable from outside the host.
JOURNAL_SMTP_BIND=
JOURNAL_HOSTNAME=
# TLS certificate chain and private key (PEM, unencrypted key), operator-supplied; paths only,
# never commit real files. Exchange Online requires TLS: the receiver does not start without
# a certificate (the archive page says "no TLS certificate") and never falls back to a
# built-in one. With a certificate, mail is refused until STARTTLS, and renewed files are
# picked up within a few minutes. JOURNAL_TLS_DIR (default ./journal-tls) is mounted
# read-only into the api at /etc/restow/journal-tls; in the compose stack set
#   JOURNAL_TLS_CERT_PATH=/etc/restow/journal-tls/fullchain.pem
#   JOURNAL_TLS_KEY_PATH=/etc/restow/journal-tls/privkey.pem
JOURNAL_TLS_DIR=
JOURNAL_TLS_CERT_PATH=
JOURNAL_TLS_KEY_PATH=
# Local development only, NEVER in production: set to true to start the receiver without a
# certificate and without offering STARTTLS at all (Exchange Online would not deliver to it, and
# mail would cross the network in plain text). Leave empty otherwise. Ignored while a certificate
# is configured: a configured certificate that is broken never degrades to plain text. The
# release smoke checks the real TLS path and does not use it.
JOURNAL_ALLOW_INSECURE=
# Maximum accepted journal report size in MB (default 150).
JOURNAL_MAX_SIZE_MB=

# --- Development profiles (docker compose --profile dev | mail) ---
# Host port of the Vite dev server of the `dev` profile (default 5173).
RESTOW_WEB_PORT=
# Host ports of Mailpit, the development SMTP sink of the `mail` profile: SMTP (default 1025)
# and its web interface (default 8025). Point SMTP_HOST at mailpit and SMTP_PORT at 1025 to use it.
MAILPIT_SMTP_PORT=
MAILPIT_UI_PORT=

# --- Public demo (deploy/demo/ only; leave unset for a normal installation) ---
# true switches demo mode on: the demo account signs in without TOTP, a single
# guard refuses every change that could alter the installation or reach
# outside, webhooks and notifications become no-ops. See deploy/demo/README.md.
RESTOW_DEMO=
# Credentials of the demo account the deploy/demo seed creates. Shown in
# plain text on the login page (a public demo has no secret to keep), so pick
# values that carry no meaning outside the demo.
RESTOW_DEMO_EMAIL=
RESTOW_DEMO_PASSWORD=
# Shared secret between the demo seed process and the api container so the
# seed's own bootstrap calls (creating the demo tenants, sources, schedules)
# pass the demo guard; never sent by a browser. Generate with: openssl rand -hex 32
RESTOW_DEMO_SEED_TOKEN=
