# Restow public demo environment. Copy to .env and fill in.
# NEVER commit .env or real values (see the repo-root .gitignore).
#
# This is a separate, smaller environment file from the repo root's
# .env.example: it configures a whole isolated demo compose project, not a
# real installation. Read deploy/demo/README.md first.

# --- Compose files (security review finding 7) ---
# Colon-separated list, relative to this directory, that deploy/demo/reset.sh
# passes to `docker compose -f ...`. The default publishes `web` only on the
# Docker bridge gateway address (RESTOW_DEMO_BIND_ADDRESS below), never on a
# public interface — safe on any host, including a shared/production one (the
# co-hosted variant, "Option B" in the README, uses this default as-is).
# For a dedicated demo VM that should serve 80/443 publicly with its own
# automatic HTTPS ("Option A"), set:
#   RESTOW_DEMO_COMPOSE_FILES=docker-compose.yml:docker-compose.override.public.yml
RESTOW_DEMO_COMPOSE_FILES=docker-compose.yml

# --- Prebuilt images (deploy/demo/build-images.sh) ---
# This host never builds: reset.sh runs `up --no-build` and stops before
# touching anything if an image is missing. Leave empty for the defaults,
# which match build-images.sh: restow-demo-app:local, restow-demo-web:local
# (own, demo-only tags, deliberately distinct from the repo-root
# docker-compose.yml's restow:local/restow-web:local — security review
# finding M2: on a host that also runs production, `docker load` of the
# demo tarball must never re-tag, and so silently recreate, that host's
# production containers), restow-demo-seed:local and
# restow-demo-dovecot:local. Only set RESTOW_DEMO_APP_IMAGE=restow:local and
# RESTOW_DEMO_WEB_IMAGE=restow-web:local (an explicit opt-in, both here and
# when running build-images.sh) when they are built from the exact release
# production runs.
RESTOW_DEMO_APP_IMAGE=
RESTOW_DEMO_WEB_IMAGE=
RESTOW_DEMO_SEED_IMAGE=
RESTOW_DEMO_DOVECOT_IMAGE=

# --- Public URL and domain ---
# The demo's own domain, used by Caddy for automatic HTTPS on its own VM
# (Option A). For the co-hosted variant (Option B, the default compose
# files above), set this to ":80" instead — Caddy then serves plain HTTP on
# the bridge-gateway port and never attempts its own certificate; the
# production Caddy terminates the real TLS (see the README).
RESTOW_DEMO_APP_DOMAIN=
# Same value as https://<RESTOW_DEMO_APP_DOMAIN> (origin only). Also used
# for the co-hosted variant: still the public hostname visitors use, even
# though Caddy itself only sees ":80" there.
RESTOW_PUBLIC_URL=
# Send Strict-Transport-Security: true only on Option A (the demo's own VM,
# RESTOW_DEMO_APP_DOMAIN a real domain, this Caddy terminating its own valid
# TLS certificate). Leave empty for the co-hosted Option B, where this Caddy
# never sees TLS at all (RESTOW_DEMO_APP_DOMAIN=:80) — the production edge in
# front of it is a separate installation with its own RESTOW_EDGE_HSTS.
RESTOW_EDGE_HSTS=
# Reached from inside the compose project only (never through the public
# edge); the seed uses it directly, and matches RESTOW_API_PORT convention
# of the main .env.example. Leave as the default unless the api service is
# renamed.
RESTOW_API_URL=http://api:3000

# --- Database (three roles, matching the repo-root .env.example) ---
POSTGRES_PASSWORD=
DATABASE_MIGRATION_URL=
DATABASE_URL=
DATABASE_PROVIDER_URL=

# --- Secrets / crypto (generate with: openssl rand -base64 32) ---
RESTOW_MASTER_KEY=
BETTER_AUTH_SECRET=

# --- Edition shown in the demo without a license key (README.md, "Edition") ---
# Honoured only because RESTOW_DEMO=true (docker-compose.yml); a full build's ee/ modules
# ignore it anywhere else.
RESTOW_EDITION=service_provider

# --- Demo account (shown in plain text on the login page; see login.tsx) ---
RESTOW_DEMO_EMAIL=
RESTOW_DEMO_PASSWORD=
# Bootstraps the demo tenants/sources/schedules through the demo guard's
# seed bypass (apps/api middleware/demo-guard.ts). POST /api/v1/setup is not
# on the public allowlist even with this token (security review finding 1):
# routes/setup.ts additionally refuses any admin but RESTOW_DEMO_EMAIL/
# RESTOW_DEMO_PASSWORD above. Generate with: openssl rand -hex 32
RESTOW_DEMO_SEED_TOKEN=

# --- Visitor IP handling (security review findings 2, 3 and M1) ---
# Demo mode turns off better-auth's IP handling altogether
# (disableIpTracking, apps/api auth.ts) so no visitor's IP is ever stored;
# there is deliberately no trusted-proxies setting for it here, because that
# would never be consulted anyway (see the comment above disableIpTracking).
# Rate limiting every write a public visitor can reach — sign-in included,
# since better-auth's own limiter cannot run without an IP — is instead the
# demo guard's own job (apps/api middleware/demo-guard.ts), keyed on the
# first X-Forwarded-For hop the demo's Caddy passes on (README, "Option B").
# That counter is in-memory only and never written anywhere.

# --- Synthetic Dovecot mailboxes (deploy/demo/dovecot, deploy/demo/seed) ---
# Comma-separated logins; must match deploy/demo/seed/src/company.ts.
RESTOW_DEMO_MAILBOXES=info@example.org,accounting@example.org,sales@example.org

# --- History for the charts (deploy/demo/seed, README "The seed and the synthetic mail") ---
# Simulated days of backups, verifications and restores before today; each
# day is a real backup round, moved back to its day afterwards through
# DATABASE_PROVIDER_URL. 0 switches the history off (one day, as before). The
# two simulated machines (README, "Simulated machines") follow the same number
# of days.
RESTOW_DEMO_HISTORY_DAYS=30
# One shared password for every demo mailbox (fully synthetic system, not a
# real secret; still never commit a real value).
RESTOW_DEMO_IMAP_PASSWORD=

# --- Simulated live runs (agent-sim, README "Simulated live runs") ---
# The agent sidecar plays backups of the two simulated machines with live
# progress, so the job list, the throughput chart and the run detail always
# have something running. Agent API calls only: nothing is uploaded and the
# repositories do not grow. Leave empty for the defaults shown; false
# switches it off (the sidecar then only sends heartbeats).
RESTOW_DEMO_SIM_RUNS=
# Typical rest of a machine between two of its runs, in seconds (default
# 240, jittered ±50 %). Whenever no run is going, the next one starts within
# 20 s, so this mostly decides how often both machines run at once.
RESTOW_DEMO_SIM_INTERVAL_SECONDS=
# Shortest and longest run, in seconds (defaults 120 and 360; 20 to 3600).
RESTOW_DEMO_SIM_MIN_DURATION_SECONDS=
RESTOW_DEMO_SIM_MAX_DURATION_SECONDS=
# Seconds between two progress reports of a run (default 5, the agent's
# own; 2 to 60).
RESTOW_DEMO_SIM_PROGRESS_SECONDS=

# --- Where `web` is published (docker-compose.yml) ---
# Host address and port `web` publishes on. Default 172.17.0.1:8081: the
# Docker bridge gateway (docker0) of a standard Linux Docker host, which the
# host itself and its containers use — the production Caddy gets there
# through host.docker.internal (host-gateway) — and which is not a public
# interface. Find the gateway with
#   docker network inspect bridge --format '{{(index .IPAM.Config 0).Gateway}}'
# if the daemon uses a different bridge subnet. reset.sh refuses 0.0.0.0 and
# ::. The port must match deploy/caddy-sites/demo.caddy on the production side.
RESTOW_DEMO_BIND_ADDRESS=
RESTOW_DEMO_BIND_PORT=
