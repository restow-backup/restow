# Restow release stack: copy to .env and fill in every empty value.
# NEVER commit .env or real values. This file carries empty placeholders only.
# All other options, each explained, are in the repository's root .env.example.

# --- Images (the build and the version to run) ---
# Every release has two builds; pick one and use both of its images with the same version:
#   full       RESTOW_IMAGE=ghcr.io/restow-backup/restow:0.3.2
#              RESTOW_WEB_IMAGE=ghcr.io/restow-backup/restow-web:0.3.2
#              The Apache-2.0 core plus the Business and Service Provider modules (Restow
#              Enterprise License), which stay locked until a license key is installed.
#   Community  RESTOW_IMAGE=ghcr.io/restow-backup/restow-community:0.3.2
#              RESTOW_WEB_IMAGE=ghcr.io/restow-backup/restow-web-community:0.3.2
#              The Apache-2.0 core only: no Business or Service Provider modules, one tenant.
# Both required. The opt-in updater rewrites these two lines itself on every update, with the
# images of the build it runs from (no edit by hand); without it, change them yourself to
# update or to switch builds.
# (Do not set RESTOW_VERSION: the image carries its own version.)
RESTOW_IMAGE=
RESTOW_WEB_IMAGE=

# --- Address ---
# Public origin the browser uses (origin only), for example https://app.example.com
RESTOW_PUBLIC_URL=
# Domain the Caddy edge serves and gets a certificate for, for example app.example.com
RESTOW_APP_DOMAIN=
# Host ports of the Caddy edge (defaults 80 and 443). Let's Encrypt needs both reachable on the
# standard ports, so change them only behind another reverse proxy or for a local evaluation.
# A value may carry an address (127.0.0.1:8443) to publish that port on this interface only.
RESTOW_HTTP_PORT=
RESTOW_HTTPS_PORT=
# Host port on which the api is published on 127.0.0.1 only (default 3000). The edge reaches the
# api over the compose network and does not use it.
RESTOW_API_PORT=
# Peers whose X-Forwarded-For the edge keeps (and appends to) instead of replacing with the
# peer's own address: space-separated CIDR ranges, or `private_ranges`. Needed only when another
# reverse proxy sits in front of this one (default: loopback only, nothing changes for a normal
# installation).
RESTOW_EDGE_TRUSTED_PROXIES=
# Where the edge gets its certificate: acme (the default, also when empty: Let's Encrypt for a public
# domain, Caddy's own authority for localhost and internal names) or internal (Caddy's own
# certificate authority for RESTOW_APP_DOMAIN, whatever the name, with no public DNS record and no
# inbound port 80). Use internal when another reverse proxy sits in front of this edge and reaches it
# over HTTPS (the installer's --behind-proxy, from 0.2.0). The root certificate to verify the edge
# with is /data/caddy/pki/authorities/local/root.crt in the caddy-data volume.
RESTOW_EDGE_TLS=
# Send Strict-Transport-Security once RESTOW_APP_DOMAIN is a real, publicly resolvable domain
# with this edge terminating its own valid TLS certificate: true | false (default false). It must
# be exactly lowercase "true"; anything else leaves HSTS off. Never set it for a local or IP
# installation or a bare HTTP domain: browsers then stay on HTTPS for a host that may never serve
# it, until the max-age expires. Sent with includeSubDomains.
RESTOW_EDGE_HSTS=

# --- Database ---
# Three roles, three passwords (generate each with: openssl rand -hex 16):
#   DATABASE_MIGRATION_URL  the database owner (POSTGRES_USER), runs migrations only:
#                           postgres://restow:<POSTGRES_PASSWORD>@postgres:5432/restow
#   DATABASE_URL            the application role, subject to Row Level Security:
#                           postgres://restow_app:<password>@postgres:5432/restow
#   DATABASE_PROVIDER_URL   the installation role:
#                           postgres://restow_provider:<password>@postgres:5432/restow
# The migration step creates the two application roles with the names and
# passwords given here.
POSTGRES_PASSWORD=
# Owner role and database name of the postgres service (default restow for both). Change them
# only before the first start, and use the same names in DATABASE_MIGRATION_URL.
POSTGRES_USER=
POSTGRES_DB=
DATABASE_MIGRATION_URL=
DATABASE_URL=
DATABASE_PROVIDER_URL=

# --- Secrets (generate each with: openssl rand -base64 32) ---
# 32-byte key encryption key. Wraps every tenant key: keep a copy offline. Without
# it no backup can ever be read again.
RESTOW_MASTER_KEY=
BETTER_AUTH_SECRET=
# Optional: the one-time setup token the setup wizard asks for in its first step. Leave it
# empty and the api prints a fresh token to its log at every start until the setup is
# complete (docker compose logs api | grep 'SETUP TOKEN'). Set it (at least 16 characters,
# e.g. openssl rand -hex 16) for an unattended installation or when container logs are
# shipped elsewhere; it is then never logged. No effect once the setup is complete.
RESTOW_SETUP_TOKEN=

# --- Storage (default target: a local path inside the api and worker containers) ---
STORAGE_TARGET=local
STORAGE_LOCAL_PATH=/data/chunks

# --- Mail file import and export (https://docs.restowbackup.com/administrators/mail-import-export/), all optional ---
# Host directory mounted read-only at /var/lib/restow/import in the api and the worker. Each
# tenant uses its own subfolder <directory>/<tenant slug>/ (create it yourself): drop EML,
# MSG, MBOX or ZIP files there and pick them in Sources > Add source > Import mail files.
# Default: ./import next to docker-compose.yml.
RESTOW_IMPORT_DIR=
# Path inside the containers (default /var/lib/restow/import); change only with the mount above
IMPORT_DIR=
# Largest file accepted by the upload in bytes (default 10 GiB)
IMPORT_MAX_FILE_BYTES=
# Hours an unfinished or unused upload is kept before it is deleted (default 48)
IMPORT_UPLOAD_TTL_HOURS=
# Size of one upload chunk in bytes (default 8 MiB, allowed 64 KiB to 32 MiB)
IMPORT_SEGMENT_BYTES=
# Largest single message that is read into memory (default 256 MiB)
IMPORT_MAX_MESSAGE_BYTES=
# Bytes the uploads of one tenant may hold in staging together, counted by declared file size
# until their import has ended (default 100 GiB). A new upload that does not fit is refused.
IMPORT_MAX_STAGING_BYTES=
# Parser processes the worker runs at the same time for MSG files and message metadata, 1 to 8
# (default 2). Each one may use up to 512 MB (files above 8 MiB get a process of their own,
# up to 3 GB): lower it on a small host.
IMPORT_PARSE_WORKERS=
# Hours a finished export can be downloaded before its file is deleted (default 24)
EXPORT_TTL_HOURS=
# Bytes all unexpired export files of one tenant may take together (default 50 GiB). A new
# export request is refused, and one that no longer fits fails with a message, until older
# exports have expired.
EXPORT_MAX_TENANT_BYTES=
# Parser processes the API runs at the same time for the mail preview and attachment downloads,
# 1 to 8 (default 2), and the time one message may take for its formatted preview in
# milliseconds (default 10000); a message that needs more is shown as text or as unreadable
PREVIEW_PARSE_WORKERS=
PREVIEW_TIMEOUT_MS=

# --- Endpoint backup (servers and clients, https://docs.restowbackup.com/administrators/endpoint-backup/overview/), all optional ---
# The image ships restic (/usr/local/bin/restic) and the agent downloads
# (/srv/agent/<version>/<os>-<arch>/, install scripts in /srv/agent/install); the defaults
# are right for this stack. Point RESTIC_BINARY, RESTOW_AGENT_DIR or RESTOW_AGENT_INSTALL_DIR
# elsewhere only for a custom image.
RESTIC_BINARY=
RESTOW_AGENT_DIR=
RESTOW_AGENT_INSTALL_DIR=
# Where restic keeps its per-endpoint caches (default: the temp folder). A folder on the data
# volume, for example /data/restic-cache, keeps them across restarts and makes browsing faster.
RESTOW_RESTIC_CACHE_DIR=
# Storage budget of endpoint repositories in GiB (whole or decimal numbers; 0 = no budget).
# Per endpoint (default 2048 = 2 TiB; an admin can set another value per machine) and for all
# endpoints of one tenant together (default 20480 = 20 TiB). An upload beyond a budget is
# refused, restores keep working, and the alerts warn from 90 percent. Read by api and worker.
RESTOW_ENDPOINT_QUOTA_GIB=
RESTOW_ENDPOINT_TENANT_QUOTA_GIB=

# --- Opt-in updater (docker compose --profile updater, docs/UPDATING.md) ---
# The updater mounts the Docker socket, which is root on this host: read the security note in
# docs/UPDATING.md before enabling it. Enabling it needs no line below: run
#   docker compose --profile updater up -d
# once in this directory. Everything in this section is optional.
# Absolute path of the directory that holds docker-compose.yml and .env on the host (for
# example /opt/restow; the installer sets it). Empty: the directory is mounted at /project and
# the updater reads its host path from the mount. Set: it is mounted at the same path instead.
RESTOW_PROJECT_DIR=
# Where the api looks for the updater (default http://updater:8090, the updater service of the
# profile). Change it only for an updater that runs elsewhere.
RESTOW_UPDATER_URL=
# The updater's own image. Optional, and there is no separate updater image: the updater is
# the application image (the one in RESTOW_IMAGE) started with ROLE=updater. Leave it empty:
# the updater then starts from RESTOW_IMAGE and, on that first start, writes this line itself,
# pinned by digest to the image it runs (for example
# ghcr.io/restow-backup/restow:0.3.2@sha256:...), so that later rewrites of RESTOW_IMAGE do not
# change it. After every update from a signed release it sets this line to the verified image of
# that release, by digest, and recreates itself; it never moves to an image built from source.
# If you set it yourself, use an image of the same build as RESTOW_IMAGE (restow-community for
# the Community build).
RESTOW_UPDATER_IMAGE=
# The updater moves itself to every signed release it installed (above). false keeps it where
# it is; you then move it by hand (docs/UPDATING.md).
RESTOW_UPDATER_SELF_UPDATE=
# Where the updater pulls the two images from; empty (the default) = the release images of its
# own build. Set both only for a registry mirror of the release images.
RESTOW_UPDATER_IMAGE_REPOSITORY=
RESTOW_UPDATER_WEB_IMAGE_REPOSITORY=
# Repositories the updater may build an update from ("source" mode, a custom update source
# under Settings, Updates). Empty = none: source mode is off and only the signed release
# images of the default source can be installed from the web interface. Comma-separated, each
# a repository (git.example.com/acme/restow, github.com/acme/restow) or a whole host
# (git.example.com). Whatever is built from these repositories runs with access to all data
# and keys: list only repositories you trust as much as the release itself. Recreate the
# updater after a change (docker compose --profile updater up -d updater).
RESTOW_UPDATER_SOURCE_HOSTS=

# --- Opt-in mounter for NFS shares (docker compose --profile mounts, docs/MOUNTS.md) ---
# The mounter mounts the Docker socket, which is root on this host: read docs/MOUNTS.md before
# enabling it. Enabling it needs no line below: run
#   docker compose --profile mounts up -d mounter
# once in this directory. It uses RESTOW_PROJECT_DIR like the updater. Everything here is optional.
# The mounter's own image: the application image started with ROLE=mounter. Leave it empty: the
# mounter then starts from RESTOW_IMAGE and, on that first start, writes this line itself,
# pinned by digest to the image it runs. The opt-in updater moves it to the verified image of
# every signed update it installs. Without the updater, to move it, set it (or empty it) and
# run docker compose --profile mounts up -d mounter
RESTOW_MOUNTER_IMAGE=
# Where the api looks for the mounter (default http://mounter:8091). Change it only for a
# mounter that runs elsewhere.
RESTOW_MOUNTER_URL=

# --- Optional ---
# The product name the web app, mails, reports and the API documentation show (default
# "Restow"). A display name only; the variable names, programs and headers keep theirs.
RESTOW_PRODUCT_NAME=
# Port of the archive journal SMTP receiver (Business and Service Provider). Leave
# empty to keep it closed. To receive Exchange Online journal reports set it to 25
# and JOURNAL_SMTP_BIND to 0.0.0.0 (the receiver must be reachable from the internet;
# without a bind address it is mapped on the loopback interface only).
JOURNAL_SMTP_PORT=
JOURNAL_SMTP_BIND=
# Host name Exchange Online delivers to (for example archive.example.com), without scheme,
# port or mail address. It forms the tenants' journal addresses
# (journal+<token>@<this host>) shown on the archive page; publish it in DNS.
JOURNAL_HOSTNAME=
# TLS certificate and private key for that host name (PEM, unencrypted key). Exchange Online
# requires TLS, so the receiver does not start without them: the archive page then says
# "no TLS certificate", and it never falls back to a built-in certificate. The certificate
# must come from a publicly trusted authority and match JOURNAL_HOSTNAME.
# Put the two files into the directory JOURNAL_TLS_DIR (default ./journal-tls next to
# docker-compose.yml; the api sees it read-only as /etc/restow/journal-tls) and set:
#   JOURNAL_TLS_CERT_PATH=/etc/restow/journal-tls/fullchain.pem   (certificate chain, leaf first)
#   JOURNAL_TLS_KEY_PATH=/etc/restow/journal-tls/privkey.pem
# A renewed certificate is picked up from the same files within a few minutes, without a
# restart. The api reads them at start and expects them to be valid: restart it after you
# first put them there, or after a start that failed because they were missing or expired.
# Where the certificate comes from (https://docs.restowbackup.com/administrators/exchange-journaling/):
#   - The same host as RESTOW_APP_DOMAIN: copy Caddy's certificate, for example daily:
#       docker compose cp "caddy:/data/caddy/certificates/<ACME directory>/<host>/<host>.crt" ./journal-tls/fullchain.pem
#       docker compose cp "caddy:/data/caddy/certificates/<ACME directory>/<host>/<host>.key" ./journal-tls/privkey.pem
#     (list the <ACME directory> with: docker compose exec caddy ls /data/caddy/certificates)
#   - Any other host name: an ACME client on the host (certbot, acme.sh, lego) with the DNS
#     challenge (Caddy holds port 80), and a deploy hook that copies the files (cp -L, not
#     the symlinks of certbot's live directory) into JOURNAL_TLS_DIR.
JOURNAL_TLS_DIR=
JOURNAL_TLS_CERT_PATH=
JOURNAL_TLS_KEY_PATH=
