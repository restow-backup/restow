# Restow release stack: copy to .env, fill in the required values. Every variable: https://docs.restowbackup.com
# NEVER commit .env or real values. More options: the repository's root .env.example.

# --- Required ---
# Both images of one build, same version: restow + restow-web, or restow-community + restow-web-community
RESTOW_IMAGE=
RESTOW_WEB_IMAGE=
# Origin the browser uses, e.g. https://app.example.com
RESTOW_PUBLIC_URL=
# Domain the edge serves and gets a certificate for, e.g. app.example.com
RESTOW_APP_DOMAIN=
# openssl rand -hex 16
POSTGRES_PASSWORD=
# postgres://restow:<POSTGRES_PASSWORD>@postgres:5432/restow
DATABASE_MIGRATION_URL=
# postgres://restow_app:<password>@postgres:5432/restow
DATABASE_URL=
# postgres://restow_provider:<password>@postgres:5432/restow
DATABASE_PROVIDER_URL=
# openssl rand -base64 32; keep a copy offline: without it no backup can be read
RESTOW_MASTER_KEY=
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Optional ---
RESTOW_HTTP_PORT=
RESTOW_HTTPS_PORT=
RESTOW_API_PORT=
RESTOW_EDGE_TRUSTED_PROXIES=
RESTOW_EDGE_TLS=
# Only for a public domain with this edge's own valid certificate
RESTOW_EDGE_HSTS=
# Change only before the first start
POSTGRES_USER=
POSTGRES_DB=
# Where the database lives; written by the updater when it moves it (docs/DATABASE.md)
RESTOW_POSTGRES_DATA_TYPE=
RESTOW_POSTGRES_DATA=
RESTOW_SETUP_TOKEN=
STORAGE_TARGET=local
STORAGE_LOCAL_PATH=/data/chunks
RESTOW_IMPORT_DIR=
IMPORT_DIR=
IMPORT_MAX_FILE_BYTES=
IMPORT_UPLOAD_TTL_HOURS=
IMPORT_SEGMENT_BYTES=
IMPORT_MAX_MESSAGE_BYTES=
IMPORT_MAX_STAGING_BYTES=
IMPORT_PARSE_WORKERS=
EXPORT_TTL_HOURS=
EXPORT_MAX_TENANT_BYTES=
PREVIEW_PARSE_WORKERS=
PREVIEW_TIMEOUT_MS=
RESTIC_BINARY=
RESTOW_AGENT_DIR=
RESTOW_AGENT_INSTALL_DIR=
RESTOW_RESTIC_CACHE_DIR=
RESTOW_ENDPOINT_QUOTA_GIB=
RESTOW_ENDPOINT_TENANT_QUOTA_GIB=

# --- Opt-in updater and mounter (they mount the Docker socket: root on the host) ---
# Absolute path of this directory, e.g. /opt/restow (the installer sets it)
RESTOW_PROJECT_DIR=
RESTOW_UPDATER_URL=
# Written by the updater itself; leave empty
RESTOW_UPDATER_IMAGE=
RESTOW_UPDATER_SELF_UPDATE=
RESTOW_UPDATER_IMAGE_REPOSITORY=
RESTOW_UPDATER_WEB_IMAGE_REPOSITORY=
# Builds from these repositories get access to all data and keys
RESTOW_UPDATER_SOURCE_HOSTS=
# Written by the mounter itself; leave empty
RESTOW_MOUNTER_IMAGE=
RESTOW_MOUNTER_URL=

# --- Other ---
RESTOW_PRODUCT_NAME=
JOURNAL_SMTP_PORT=
JOURNAL_SMTP_BIND=
JOURNAL_HOSTNAME=
JOURNAL_TLS_DIR=
JOURNAL_TLS_CERT_PATH=
JOURNAL_TLS_KEY_PATH=
