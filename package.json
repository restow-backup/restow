{
  "name": "restow",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:libs": "pnpm --filter @restow/core --filter @restow/db --filter @restow/i18n build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm build:libs && pnpm -r --workspace-concurrency=2 test",
    "test:ci": "pnpm build:libs && pnpm -r --workspace-concurrency=2 test -- --reporter=default --reporter=json --outputFile=test-results/vitest.json",
    "test:pg-guard": "node scripts/ci/assert-pg-suites.mjs",
    "lint": "biome check . && node scripts/ci/check-ee-boundary.mjs && node scripts/ci/check-legacy-name.mjs && node scripts/ci/check-package-files.mjs",
    "format": "biome format --write .",
    "dev:web": "pnpm --filter @restow/web dev",
    "dev:api": "pnpm --filter @restow/api dev",
    "db:generate": "pnpm --filter @restow/db generate",
    "db:migrate": "pnpm --filter @restow/db migrate",
    "smoke": "node scripts/smoke/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
