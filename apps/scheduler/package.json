{
  "name": "@restow/scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Restow scheduler: a single leader-elected process that enqueues due backup, verify, retention and scrub jobs onto pg-boss.",
  "license": "Apache-2.0",
  "files": ["dist", "!**/*.test.*", "!**/testing", "!**/testdata", "!**/fixtures"],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@restow/core": "workspace:*",
    "@restow/db": "workspace:*",
    "pg": "^8.13.0",
    "pg-boss": "^10.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  }
}
